import { fetch } from 'wix-fetch';

// Your live AWS API Gateway Endpoint
const AWS_API_URL = "https://qy1dw2zola.execute-api.us-east-1.amazonaws.com/default/RomaMockExamHandler";

/**
 * Function 1: Fetch the dynamic catalog menu
 * We are using this right now on the main page.
 */
export async function fetchMockExamCatalog() {
    try {
        const url = `${AWS_API_URL}?action=get_catalog&examType=icfes`;
        
        const response = await fetch(url, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`AWS HTTP Error: ${response.status}`);
        }

        const responseData = await response.json();
        
        // Return directly the "catalog" array with the 5 items
        if (responseData.data && responseData.data.catalog) {
            return responseData.data.catalog;
        } else {
            throw new Error("Formato de respuesta inválido de AWS para el catálogo.");
        }

    } catch (error) {
        console.error("Error al traer el catálogo desde AWS:", error);
        return []; // Return an empty array on error so the page doesn't crash
    }
}

/**
 * Function 2: Fetch a specific exam (Heavy JSON)
 * This function is ready for the next step when a user clicks a subject.
 */
export async function fetchSpecificExam(component, examId) {
    try {
        const url = `${AWS_API_URL}?action=get_exam&examType=icfes&component=${component}&examId=${examId}`;
        
        const response = await fetch(url, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`AWS HTTP Error: ${response.status}`);
        }

        const responseData = await response.json();
        
        if (responseData.data && responseData.data.exam_data) {
            return responseData.data; // Return the full payload (metadata + questions)
        } else {
            throw new Error("Formato de respuesta inválido de AWS para el examen.");
        }

    } catch (error) {
        console.error(`Error al traer el examen ${examId} para ${component}:`, error);
        return null;
    }
}