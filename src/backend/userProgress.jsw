// src/backend/userProgress.jsw
import { Permissions, webMethod } from "wix-web-module";
import { fetch } from 'wix-fetch';

/**
 * Fetches exam progress for a specific user from your AWS API.
 * * @param {string} userId - The unique ID of the user requesting their data.
 * @returns {Promise<Object>} - The progress data or an error object.
 */
export const fetchUserProgress = webMethod(
  Permissions.Anyone,
  async (userId) => {
    // This is the AWS API Gateway endpoint we tested in Postman
    const url = `https://sljyavsulf.execute-api.us-east-1.amazonaws.com/prod/GetUserProgressHandler?userId=${userId}`;

    try {
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error(`AWS API returned status: ${response.status}`);
      }

      // Parse the JSON response from AWS
      const json = await response.json();
      
      // Returns { ok: true, progress: [...] }
      return json; 
      
    } catch (error) {
      console.error("❌ Error fetching user progress from AWS:", error);
      // Return a safe fallback object so the frontend doesn't crash
      return { ok: false, progress: [], error: error.message };
    }
  }
);